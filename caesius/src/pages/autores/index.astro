---
// Lista de autores.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const autores = (await getCollection('autores')).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, 'es'),
);
---

<Base titulo="Autores" descripcion="Quién escribe en Caesius.">
  <div class="contenedor">
    <header class="pagina__cabecera">
      <h1>Autores</h1>
    </header>
    <ul class="autores">
      {autores.map((autor) => (
        <li>
          <span class="monograma monograma--grande" aria-hidden="true">
            {autor.data.foto ? <img src={autor.data.foto} alt="" /> : autor.data.iniciales}
          </span>
          <div>
            <h3><a href={`/autores/${autor.id}`} style="color: inherit">{autor.data.nombre}</a></h3>
            <p>{autor.data.rol}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
