---
// Figura principal de un artículo. La usa la plantilla del artículo, no el
// Markdown: dentro del cuerpo de un .md las figuras van como HTML estándar
// (<figure><img …><figcaption>…</figcaption></figure>).
//
// `src`: imagen estática en public/ (SVG o PNG). Es lo que ven los lectores
//        sin JavaScript, los buscadores y las vistas previas en redes.
// `interactiva`: nombre (sin extensión) de un archivo en src/figuras/
//        exportado desde Python con
//        fig.write_html("nombre.html", include_plotlyjs=False, full_html=False)
//        Con JavaScript, sustituye a la imagen.
interface Props {
  src: string;
  alt: string;
  pie?: string;
  interactiva?: string;
}

const { src, alt, pie, interactiva } = Astro.props;

const interactivas = import.meta.glob('/src/figuras/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

let html: string | undefined;
if (interactiva) {
  html = interactivas[`/src/figuras/${interactiva}.html`];
  if (!html) {
    throw new Error(`Figura interactiva no encontrada: src/figuras/${interactiva}.html`);
  }
}
---

<figure class:list={['figura', 'figura--principal', { 'figura--interactiva': !!html }]}>
  <div class="figura__estatica">
    <img src={src} alt={alt} loading="eager" decoding="async" />
  </div>
  {html && <div class="figura__interactiva" set:html={html} />}
  {pie && <figcaption>{pie}</figcaption>}
</figure>
