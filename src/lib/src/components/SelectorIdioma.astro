---
import type { Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
  esUrl: string;
  enUrl: string;
}

const { lang, esUrl, enUrl } = Astro.props;
---

<nav class="lingue" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
  <a
    href={esUrl}
    hreflang="es"
    lang="es"
    aria-current={lang === 'es' ? 'page' : undefined}
    aria-label="Español"
  >
    ES
  </a>
  <a
    href={enUrl}
    hreflang="en"
    lang="en"
    aria-current={lang === 'en' ? 'page' : undefined}
    aria-label="English"
  >
    EN
  </a>
</nav>

<style>
  .lingue {
    display: inline-flex;
    border: 1px solid var(--gris-200);
    font-family: var(--sans);
    font-size: var(--t-xs);
    line-height: 1;
  }

  .lingue a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--gris-700);
    font-weight: 500;
  }

  .lingue a + a {
    border-left: 1px solid var(--gris-200);
  }

  .lingue a:hover {
    background: var(--azul-claro);
    text-decoration: none;
  }

  .lingue a[aria-current='page'] {
    background: var(--tinta);
    color: var(--papel);
  }

  .lingue a[aria-current='page']:hover {
    background: var(--tinta);
  }
</style>
