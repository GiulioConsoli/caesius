
---
// Página de artículo. Se genera una por cada archivo en src/content/analisis/.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figura from '../../components/Figura.astro';
import DatosMetodo from '../../components/DatosMetodo.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Firmas from '../../components/Firmas.astro';
import { autoresDe } from '../../lib/autores';
import { analisisPublicados } from '../../lib/contenido';
import {
  formatearFecha,
  fechaISO,
  nombreTema,
  tiempoLectura
} from '../../lib/format';

export async function getStaticPaths() {
  const articulos = await analisisPublicados();

  return articulos.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada }
  }));
}

const { entrada } = Astro.props;
const { data } = entrada;
const { Content } = await render(entrada);
const autores = await autoresDe(entrada);

const relacionados = (await analisisPublicados())
  .filter(
    (a) =>
      a.id !== entrada.id &&
      a.data.temas.some((t) => data.temas.includes(t))
  )
  .slice(0, 3);

const url = new URL(Astro.url.pathname, Astro.site).toString();
const textoCompartir = encodeURIComponent(`${data.titulo} — Caesius`);

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.titulo,
  description: data.sumario,
  image: [new URL(data.figura.src, Astro.site).toString()],
  datePublished: data.fecha.toISOString(),
  ...(data.actualizado && {
    dateModified: data.actualizado.toISOString()
  }),
  inLanguage: 'es',
  isAccessibleForFree: true,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url
  },
  author: autores.map((autor) => ({
    '@type': 'Person',
    name: autor.data.nombre,
    url: new URL(`/autores/${autor.id}/`, Astro.site).toString()
  })),
  publisher: {
    '@type': 'Organization',
    name: 'Caesius',
    url: Astro.site?.toString()
  },
  keywords: data.temas.map(nombreTema).join(', ')
};
---

<Base
  titulo={data.tituloSeo ?? data.titulo}
  descripcion={data.sumario}
  imagen={data.figura.src}
  tipo="article"
  fechaPublicacion={data.fecha}
  noindex={data.noindex}
  plotly={!!data.figura.interactiva}
>
  <article class="articulo-caesius">

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(datosEstructurados)}
    />

    <!-- CABECERA -->
    <header class="articulo-cabecera">

      <div class="articulo-cabecera__etiquetas">
        <div class="articulo-cabecera__temas">
          {data.temas.map((tema) => (
            <a
              class="articulo-etiqueta"
              href={`/temas/${tema}`}
            >
              {nombreTema(tema)}
            </a>
          ))}
        </div>

        <span class="articulo-cabecera__lectura">
          {tiempoLectura(entrada.body)} min de lectura
        </span>
      </div>

      <h1>{data.titulo}</h1>

      <p class="articulo-cabecera__sumario">
        {data.sumario}
      </p>

      <!-- AUTORÍA -->
      <div class="articulo-cabecera__firma">

        <div class="articulo-cabecera__autores">
          {autores.map((autor) => (
            <a
              class="autor-mini"
              href={`/autores/${autor.id}`}
            >
              <span class="autor-mini__avatar">
                {autor.data.foto ? (
                  <img
                    src={autor.data.foto}
                    alt=""
                    loading="lazy"
                  />
                ) : (
                  <span>{autor.data.iniciales}</span>
                )}
              </span>

              <span class="autor-mini__nombre">
                {autor.data.nombre}
              </span>
            </a>
          ))}
        </div>

        <div class="articulo-cabecera__fecha">
          <time datetime={fechaISO(data.fecha)}>
            {formatearFecha(data.fecha)}
          </time>

          {data.actualizado && (
            <span>
              Actualizado el {formatearFecha(data.actualizado, 'corta')}
            </span>
          )}
        </div>

      </div>
    </header>

    <!-- FIGURA PRINCIPAL -->
    <div class="articulo-portada">
      <Figura
        src={data.figura.src}
        alt={data.figura.alt}
        pie={data.figura.pie}
        interactiva={data.figura.interactiva}
      />
    </div>

    <!-- CONTENIDO MARKDOWN -->
    <div class="articulo-prosa prosa">
      <Content />
    </div>

    <!-- DATOS Y MÉTODO -->
    <div class="articulo-metodo">
      <DatosMetodo datos={data} />
    </div>

    <!-- PIE -->
    <footer class="articulo-footer">

      <div class="articulo-compartir">
        <span>Compartir este análisis</span>

        <div class="articulo-compartir__enlaces">
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${textoCompartir}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            X
          </a>

          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>

          <button
            type="button"
            class="copiar-enlace"
            data-url={url}
          >
            Copiar enlace
          </button>
        </div>
      </div>

      <!-- FICHAS DE AUTOR -->
      <div class="articulo-autores">
        {autores.map((autor) => (
          <a
            class="autor-caja"
            href={`/autores/${autor.id}`}
          >
            <span class="autor-caja__avatar">
              {autor.data.foto ? (
                <img
                  src={autor.data.foto}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <span>{autor.data.iniciales}</span>
              )}
            </span>

            <span class="autor-caja__info">
              <strong>{autor.data.nombre}</strong>
              <span>{autor.data.rol}</span>
            </span>

            <span class="autor-caja__flecha" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>

      <!-- ARTÍCULOS RELACIONADOS -->
      {relacionados.length > 0 && (
        <section
          class="articulo-relacionados"
          aria-labelledby="relacionados"
        >
          <h2 id="relacionados">
            Sigue explorando
          </h2>

          <ul class="rejilla">
            {relacionados.map((a) => (
              <Tarjeta entrada={a} />
            ))}
          </ul>
        </section>
      )}

    </footer>
  </article>
</Base>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('.copiar-enlace')
    .forEach((boton) => {
      boton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(
            boton.dataset.url ?? location.href
          );

          const original = boton.textContent;
          boton.textContent = '¡Enlace copiado!';

          setTimeout(() => {
            boton.textContent = original;
          }, 2000);
        } catch {
          boton.textContent = 'No se pudo copiar';
        }
      });
    });
</script>

<style>
  /* ======================================
     CONTENEDOR GENERAL
     ====================================== */

  .articulo-caesius {
    --articulo-texto: #f5f5f3;
    --articulo-secundario: #b9b9bc;
    --articulo-borde: #343434;

    width: min(calc(100% - 48px), 900px);
    margin: 0 auto;
    padding: 125px 0 110px;

    color: var(--articulo-texto);
    font-family: var(--sans);
  }

  /* ======================================
     CABECERA
     ====================================== */

  .articulo-cabecera {
    margin-bottom: 40px;
  }

  .articulo-cabecera__etiquetas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 25px;
  }

  .articulo-cabecera__temas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .articulo-etiqueta {
    display: inline-flex;
    align-items: center;

    padding: 7px 13px;
    border-radius: 999px;

    background: #dce1ff;
    color: #3947bb;

    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.025em;

    text-decoration: none;
    transition: background 180ms ease;
  }

  .articulo-etiqueta:hover {
    background: #bfd4ff;
  }

  .articulo-cabecera__lectura {
    font-size: 12px;
    color: var(--articulo-secundario);
  }

  .articulo-cabecera h1 {
    max-width: 900px;
    margin: 0;

    font-family: var(--display);
    font-size: clamp(30px, 3.5vw, 47px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.055em;

    color: #f5f5f3;
    overflow-wrap: break-word;
  }

  .articulo-cabecera__sumario {
    max-width: 820px;
    margin: 25px 0 30px;

    font-family: var(--sans);
    font-size: clamp(17px, 1.7vw, 21px);
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.02em;

    color: #c2c2c5;
  }

  /* ======================================
     FIRMA
     ====================================== */

  .articulo-cabecera__firma {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;

    padding: 20px 0;
    border-top: 1px solid var(--articulo-borde);
    border-bottom: 1px solid var(--articulo-borde);
  }

  .articulo-cabecera__autores {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  .autor-mini {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    color: #f5f5f3;
    text-decoration: none;
  }

  .autor-mini__avatar {
    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;
    flex-shrink: 0;

    overflow: hidden;
    border-radius: 50%;

    background: #dce1ff;
    color: #3947bb;

    font-size: 12px;
    font-weight: 600;
  }

  .autor-mini__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .autor-mini__nombre {
    font-size: 13px;
    font-weight: 600;
    color: #f5f5f3;
  }

  .autor-mini:hover .autor-mini__nombre {
    color: #8197ff;
  }

  .articulo-cabecera__fecha {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;

    font-size: 12px;
    color: var(--articulo-secundario);
  }

  /* ======================================
     FIGURA PRINCIPAL
     ====================================== */

  .articulo-portada {
    margin: 0 0 55px;
  }

  .articulo-portada :global(figure) {
    margin: 0;
  }

  .articulo-portada :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .articulo-portada :global(figcaption) {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: #a8a8a8;
  }

  /* ======================================
     CUERPO DEL ARTÍCULO
     ====================================== */

  .articulo-prosa {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;

    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.85;
    color: #d5d5d5;

    overflow-wrap: break-word;
  }

  .articulo-prosa :global(p) {
    margin: 0 0 25px;
  }

  .articulo-prosa :global(h2) {
    margin: 65px 0 22px;

    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.045em;

    color: #f5f5f3;
  }

  .articulo-prosa :global(h3) {
    margin: 42px 0 18px;

    font-family: var(--sans);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.4;

    color: #f5f5f3;
  }

  .articulo-prosa :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .articulo-prosa :global(a) {
    color: #8197ff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .articulo-prosa :global(a:hover) {
    color: #00b4e8;
  }

  .articulo-prosa :global(ul),
  .articulo-prosa :global(ol) {
    margin: 20px 0 28px;
    padding-left: 25px;
  }

  .articulo-prosa :global(li) {
    margin-bottom: 12px;
  }

  .articulo-prosa :global(blockquote) {
    margin: 35px 0;
    padding: 12px 0 12px 25px;

    border-left: 3px solid #8197ff;
    color: #dce1ff;
  }

  /* ======================================
     FIGURAS DENTRO DEL MARKDOWN
     ====================================== */

  .articulo-prosa :global(figure) {
    margin: 45px 0;
    width: 100%;
  }

  .articulo-prosa :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .articulo-prosa :global(figcaption) {
    margin-top: 12px;
    font-family: var(--sans);
    font-size: 12px;
    line-height: 1.65;
    color: #a8a8a8;
  }

  /* ======================================
     TABLAS DEL MARKDOWN
     ====================================== */

  .articulo-prosa :global(table) {
    width: 100%;
    margin: 35px 0;

    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.6;
  }

  .articulo-prosa :global(th),
  .articulo-prosa :global(td) {
    padding: 13px 15px;
    text-align: left;
    vertical-align: top;

    border-bottom: 1px solid #343434;
  }

  .articulo-prosa :global(th) {
    color: #f5f5f3;
    background: #1d1d1d;
    font-weight: 600;
  }

  .articulo-prosa :global(td) {
    color: #c9c9c9;
  }

  .articulo-prosa :global(tr:hover td) {
    background: #191919;
  }

  /* ======================================
     DATOS Y MÉTODO
     ====================================== */

  .articulo-metodo {
    margin-top: 75px;
    padding-top: 35px;
    border-top: 1px solid #343434;
  }

  /* ======================================
     PIE DEL ARTÍCULO
     ====================================== */

  .articulo-footer {
    margin-top: 65px;
  }

  .articulo-compartir {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;

    padding: 22px 0;
    border-top: 1px solid #343434;
    border-bottom: 1px solid #343434;
  }

  .articulo-compartir > span {
    color: #f5f5f3;
    font-size: 13px;
    font-weight: 600;
  }

  .articulo-compartir__enlaces {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .articulo-compartir__enlaces a,
  .copiar-enlace {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: #8197ff;

    background: none;
    border: 0;
    padding: 0;

    text-decoration: none;
    cursor: pointer;
  }

  .articulo-compartir__enlaces a:hover,
  .copiar-enlace:hover {
    color: #00b4e8;
  }

  /* ======================================
     FICHAS DE AUTOR
     ====================================== */

  .articulo-autores {
    display: grid;
    gap: 15px;
    margin-top: 35px;
  }

  .autor-caja {
    display: flex;
    align-items: center;
    gap: 18px;

    padding: 20px;
    border: 1px solid #343434;
    border-radius: 14px;

    background: #1a1a1a;
    color: #f5f5f3;
    text-decoration: none;

    transition: border-color 180ms ease;
  }

  .autor-caja:hover {
    border-color: #8197ff;
  }

  .autor-caja__avatar {
    display: grid;
    place-items: center;

    width: 65px;
    height: 65px;
    flex-shrink: 0;

    overflow: hidden;
    border-radius: 50%;

    background: #dce1ff;
    color: #3947bb;
    font-size: 16px;
    font-weight: 600;
  }

  .autor-caja__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .autor-caja__info {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }

  .autor-caja__info strong {
    font-size: 16px;
    font-weight: 600;
    color: #f5f5f3;
  }

  .autor-caja__info > span {
    font-size: 13px;
    color: #b9b9bc;
  }

  .autor-caja__flecha {
    color: #8197ff;
    font-size: 25px;
  }

  /* ======================================
     RELACIONADOS
     ====================================== */

  .articulo-relacionados {
    margin-top: 80px;
  }

  .articulo-relacionados h2 {
    margin: 0 0 30px;

    font-family: var(--display);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.045em;

    color: #f5f5f3;
  }

  /* ======================================
     RESPONSIVE
     ====================================== */

  @media (max-width: 700px) {
    .articulo-caesius {
      width: calc(100% - 32px);
      padding: 105px 0 70px;
    }

    .articulo-cabecera h1 {
      font-size: clamp(27px, 7vw, 37px);
      line-height: 1.35;
    }

    .articulo-cabecera__sumario {
      font-size: 17px;
      line-height: 1.6;
    }

    .articulo-cabecera__firma {
      align-items: flex-start;
      flex-direction: column;
      gap: 15px;
    }

    .articulo-prosa {
      font-size: 16px;
      line-height: 1.8;
    }

    .articulo-prosa :global(h2) {
      font-size: 23px;
    }

    .articulo-prosa :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .articulo-compartir {
      align-items: flex-start;
      flex-direction: column;
    }

    .autor-caja {
      padding: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .articulo-etiqueta,
    .autor-caja {
      transition: none;
    }
  }
</style>
