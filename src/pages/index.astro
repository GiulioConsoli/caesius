---
// Portada: pieza de apertura con su figura, rejilla de los últimos análisis.
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Firmas from '../components/Firmas.astro';
import { autoresDe } from '../lib/autores';
import { analisisPublicados } from '../lib/contenido';
import { formatearFecha, fechaISO, nombreTema, tiempoLectura } from '../lib/format';

const articulos = await analisisPublicados();
const apertura = articulos[0];
const resto = articulos.slice(1, 10);
const autoresApertura = apertura ? await autoresDe(apertura) : [];
---

<Base
  titulo="Caesius"
  descripcion="Análisis cuantitativos breves y largos sobre política, economía y sociedad, con los datos y el código a la vista."
  imagen={apertura?.data.figura.src}
>
  <div class="contenedor">
    {apertura ? (
      <section class="apertura" aria-label="Análisis destacado">
        <div class="apertura__texto">
          <a class="etiqueta" href={`/temas/${apertura.data.temas[0]}`}>
            {nombreTema(apertura.data.temas[0])}
          </a>
          <h1><a href={`/analisis/${apertura.id}`} style="color: inherit">{apertura.data.titulo}</a></h1>
          <p class="apertura__sumario">{apertura.data.sumario}</p>
          <div class="firma">
            <Firmas autores={autoresApertura} />
            <time datetime={fechaISO(apertura.data.fecha)}>{formatearFecha(apertura.data.fecha)}</time>
            <span class="lectura">{tiempoLectura(apertura.body)} min</span>
          </div>
        </div>
        <figure class="apertura__figura">
          <a href={`/analisis/${apertura.id}`}>
            <img src={apertura.data.figura.src} alt={apertura.data.figura.alt} loading="eager" />
          </a>
          {apertura.data.figura.pie && <figcaption>{apertura.data.figura.pie}</figcaption>}
        </figure>
      </section>
    ) : (
      <section class="pagina__cabecera">
        <h1>Caesius</h1>
        <p>Todavía no hay análisis publicados.</p>
      </section>
    )}

    {resto.length > 0 && (
      <>
        <div class="separador" role="presentation"></div>
        <section aria-labelledby="ultimos">
          <div class="seccion__cabecera">
            <h2 id="ultimos">Últimos análisis</h2>
            <a href="/analisis">Ver todos →</a>
          </div>
          <ul class="rejilla">
            {resto.map((a) => (
              <Tarjeta entrada={a} />
            ))}
          </ul>
        </section>
      </>
    )}
  </div>
</Base>
