
---
// Fondo ASCII editorial: neutro, discreto e interactivo.
---

<div class="ascii-field" aria-hidden="true">
  <canvas class="ascii-field__canvas"></canvas>
</div>

<style>
  .ascii-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ascii-field__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  function initAsciiFields() {
    document.querySelectorAll<HTMLElement>('.ascii-field').forEach((field) => {
      if (field.dataset.ready === 'true') return;
      field.dataset.ready = 'true';

      const canvas = field.querySelector('canvas');
      const ctx = canvas?.getContext('2d');
      if (!canvas || !ctx) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const host = field.parentElement ?? field;
      const glyphs = ['·', '·', '.', '·', ':'];
      let width = 1;
      let height = 1;
      let step = 15;
      let cols = 0;
      let rows = 0;
      let frame = 0;
      let raf = 0;
      let pointerX = -10000;
      let pointerY = -10000;
      let active = false;

      function resize() {
        const rect = field.getBoundingClientRect();

        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);

        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas!.width = Math.round(width * dpr);
        canvas!.height = Math.round(height * dpr);

        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        step = width < 700 ? 23 : 21;
        cols = Math.ceil(width / step);
        rows = Math.ceil(height / step);

        draw();
      }

      function draw() {
        ctx!.clearRect(0, 0, width, height);

        ctx!.textAlign = 'center';
        ctx!.textBaseline = 'middle';
        ctx!.font = `${Math.round(step * .72)}px monospace`;

        const t = reduce.matches ? 0 : frame * .004;

        for (let y = 0; y <= rows; y++) {
          for (let x = 0; x <= cols; x++) {
            const px = x * step + step / 2;
            const py = y * step + step / 2;

            const nx = px / width;
            const ny = py / height;

            // Ondas repartidas por toda la superficie.
            const wave =
              Math.sin(nx * 11 + ny * 8 + t) * .22 +
              Math.sin(nx * 19 - ny * 12 - t * .65) * .13 +
              Math.cos(nx * 5 + ny * 15 + t * .4) * .12;

            const texture =
              Math.sin(nx * 35 + ny * 17) * .055;

            const density = .31 + wave + texture;

            const random = Math.abs(
              Math.sin(x * 127.1 + y * 311.7) * 43758.5453 % 1
            );

            const probability = Math.max(
              .025,
              Math.min(.30, density * .55)
            );

            if (random > probability) continue;

            const dx = px - pointerX;
            const dy = py - pointerY;
            const distance = Math.hypot(dx, dy);

            const influence = active && !reduce.matches
              ? Math.pow(Math.max(0, 1 - distance / 175), 2)
              : 0;

            const offset = influence * 11;

            const gx = px + (
              distance ? dx / distance * offset : 0
            );

            const gy = py + (
              distance ? dy / distance * offset : 0
            );

            const index = Math.min(
              glyphs.length - 1,
              Math.floor(Math.max(0, density) * glyphs.length)
            );

            // Gris neutro por defecto.
            // Lavanda únicamente al acercar el cursor.
            ctx!.fillStyle = influence > .015
              ? `rgba(129,151,255,${Math.min(.38, .06 + influence * .32)})`
              : `rgba(218,218,218,${.018 + Math.max(0, density) * .055})`;

            ctx!.fillText(glyphs[index], gx, gy);
          }
        }
      }

      const tick = () => {
        frame++;
        draw();
        raf = requestAnimationFrame(tick);
      };

      const move = (event: PointerEvent) => {
        const rect = field.getBoundingClientRect();

        pointerX = event.clientX - rect.left;
        pointerY = event.clientY - rect.top;
        active = true;

        if (reduce.matches) draw();
      };

      const leave = () => {
        active = false;
        if (reduce.matches) draw();
      };

      const observer = new ResizeObserver(resize);
      observer.observe(field);

      host.addEventListener('pointermove', move);
      host.addEventListener('pointerleave', leave);

      const visibility = () => {
        cancelAnimationFrame(raf);

        if (!document.hidden && !reduce.matches) {
          raf = requestAnimationFrame(tick);
        } else {
          draw();
        }
      };

      document.addEventListener('visibilitychange', visibility);
      reduce.addEventListener('change', visibility);

      resize();
      visibility();

      document.addEventListener('astro:before-swap', () => {
        cancelAnimationFrame(raf);
        observer.disconnect();

        host.removeEventListener('pointermove', move);
        host.removeEventListener('pointerleave', leave);

        document.removeEventListener('visibilitychange', visibility);
        reduce.removeEventListener('change', visibility);
      }, { once: true });
    });
  }

  initAsciiFields();
  document.addEventListener('astro:page-load', initAsciiFields);
</script>
