---
// Cabecera del sitio: logotipo y menú de un solo nivel.
// "Manifiesto" y "Colabora" se añaden al menú cuando existan sus textos:
// basta con crear la página en src/pages/ y descomentar la línea.
const ruta = Astro.url.pathname;

const menu = [
  { texto: 'Análisis', href: '/analisis' },
  { texto: 'Elecciones', href: '/temas/elecciones' },
  { texto: 'Temas', href: '/temas' },
  { texto: 'Autores', href: '/autores' },
  // { texto: 'Manifiesto', href: '/manifiesto' },
  // { texto: 'Colabora', href: '/colabora' },
];

function activo(href: string): boolean {
  return ruta === href || ruta.startsWith(href + '/');
}
---

<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <a class="logo" href="/" aria-label="Caesius, portada">
      <span class="logo__marca" aria-hidden="true"></span>
      <span>Caesius</span>
    </a>
    <nav class="nav" aria-label="Secciones">
      {menu.map((item) => (
        <a href={item.href} aria-current={activo(item.href) ? 'page' : undefined}>
          {item.texto}
        </a>
      ))}
    </nav>
  </div>
</header>
