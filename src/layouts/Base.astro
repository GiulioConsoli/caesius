---
// Plantilla base de todas las páginas: <head>, cabecera, pie.
import '@fontsource-variable/syne';
import '@fontsource-variable/unbounded';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo: string;
  descripcion: string;
  // Imagen para las vistas previas en redes (ruta absoluta desde /).
  imagen?: string;
  tipo?: 'website' | 'article';
  fechaPublicacion?: Date;
  // true = la página carga Plotly (copia local en /vendor/).
  plotly?: boolean;
  // true = no indexar (borradores).
  noindex?: boolean;
}

const {
  titulo,
  descripcion,
  imagen = '/og-default.png',
  tipo = 'website',
  fechaPublicacion,
  plotly = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const tituloCompleto = titulo === 'Caesius' ? 'Caesius — el mundo en datos' : `${titulo} · Caesius`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Caesius" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="Caesius" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:locale" content="es_ES" />
    {fechaPublicacion && (
      <meta property="article:published_time" content={fechaPublicacion.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />

    {/* Marca el documento como "con JavaScript": los gráficos interactivos
        se muestran sólo entonces; sin JS queda la imagen estática. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    {plotly && <script is:inline src="/vendor/plotly.min.js"></script>}
  </head>
  <body>
    <Cabecera />
    <main>
      <slot />
    </main>
    <Pie />
  </body>
</html>
